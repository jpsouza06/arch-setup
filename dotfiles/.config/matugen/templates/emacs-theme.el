;;; matugen-theme.el --- Material You theme generated by Matugen -*- lexical-binding: t; -*-

(deftheme matugen "Dynamic Material You theme generated by Matugen.")

(let ((background "{{ colors.background.default.hex }}")
      (foreground "{{ colors.on_background.default.hex }}")
      (surface "{{ colors.surface_container.default.hex }}")
      (surface-high "{{ colors.surface_container_high.default.hex }}")
      (surface-highest "{{ colors.surface_container_highest.default.hex }}")
      (muted "{{ colors.on_surface_variant.default.hex }}")
      (outline "{{ colors.outline.default.hex }}")
      (primary "{{ colors.primary.default.hex }}")
      (on-primary "{{ colors.on_primary.default.hex }}")
      (primary-container "{{ colors.primary_container.default.hex }}")
      (on-primary-container "{{ colors.on_primary_container.default.hex }}")
      (secondary "{{ colors.secondary.default.hex }}")
      (tertiary "{{ colors.tertiary.default.hex }}")
      (error "{{ colors.error.default.hex }}")
      (warning "{{ colors.secondary.default.hex }}"))
  (custom-theme-set-faces
   'matugen
   `(default ((t (:background ,background :foreground ,foreground))))
   `(cursor ((t (:background ,primary :foreground ,on-primary))))
   `(fringe ((t (:background ,background :foreground ,muted))))
   `(region ((t (:background ,primary-container :foreground ,on-primary-container))))
   `(highlight ((t (:background ,surface-highest))))
   `(hl-line ((t (:background ,surface))))
   `(shadow ((t (:foreground ,muted))))
   `(link ((t (:foreground ,primary :underline t))))
   `(link-visited ((t (:foreground ,tertiary :underline t))))
   `(minibuffer-prompt ((t (:foreground ,primary :weight bold))))
   `(vertical-border ((t (:foreground ,surface-highest))))
   `(window-divider ((t (:foreground ,surface-highest))))
   `(mode-line ((t (:background ,primary-container :foreground ,on-primary-container
                    :box (:line-width 1 :color ,primary-container)))))
   `(mode-line-inactive ((t (:background ,surface :foreground ,muted
                             :box (:line-width 1 :color ,surface)))))
   `(header-line ((t (:background ,surface-high :foreground ,foreground))))
   `(line-number ((t (:background ,background :foreground ,outline))))
   `(line-number-current-line ((t (:background ,surface :foreground ,primary :weight bold))))
   `(font-lock-builtin-face ((t (:foreground ,secondary))))
   `(font-lock-comment-face ((t (:foreground ,muted :slant italic))))
   `(font-lock-comment-delimiter-face ((t (:foreground ,outline))))
   `(font-lock-constant-face ((t (:foreground ,tertiary))))
   `(font-lock-doc-face ((t (:foreground ,muted :slant italic))))
   `(font-lock-function-name-face ((t (:foreground ,primary :weight semibold))))
   `(font-lock-keyword-face ((t (:foreground ,secondary :weight bold))))
   `(font-lock-number-face ((t (:foreground ,tertiary))))
   `(font-lock-string-face ((t (:foreground ,tertiary))))
   `(font-lock-type-face ((t (:foreground ,secondary))))
   `(font-lock-variable-name-face ((t (:foreground ,foreground))))
   `(font-lock-warning-face ((t (:foreground ,warning :weight bold))))
   `(error ((t (:foreground ,error :weight bold))))
   `(warning ((t (:foreground ,warning :weight bold))))
   `(success ((t (:foreground ,tertiary :weight bold))))
   `(show-paren-match ((t (:background ,primary :foreground ,on-primary :weight bold))))
   `(show-paren-mismatch ((t (:background ,error :foreground ,background :weight bold))))
   `(isearch ((t (:background ,primary :foreground ,on-primary :weight bold))))
   `(lazy-highlight ((t (:background ,surface-highest :foreground ,foreground))))
   `(completions-common-part ((t (:foreground ,primary :weight bold))))
   `(completions-first-difference ((t (:foreground ,secondary :weight bold))))
   `(which-key-key-face ((t (:foreground ,primary :weight bold))))
   `(which-key-command-description-face ((t (:foreground ,foreground))))
   `(which-key-group-description-face ((t (:foreground ,secondary))))))

(provide-theme 'matugen)
;;; matugen-theme.el ends here
